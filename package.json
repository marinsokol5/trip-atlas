{
  "name": "trip-atlas",
  "version": "0.2.0",
  "description": "A local, read-only atlas for comparing travel plans, routes, nights and costs.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "trip-atlas": "scripts/cli.mjs"
  },
  "files": [
    "dist/",
    "dist-node/",
    "scripts/*.mjs",
    "!scripts/*.test.mjs",
    "!scripts/release.mjs",
    "!scripts/pages.mjs",
    "!scripts/schema-types.mjs",
    "skills/",
    "trips/",
    "THIRD_PARTY_NOTICES.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marinsokol5/trip-atlas.git"
  },
  "homepage": "https://github.com/marinsokol5/trip-atlas#readme",
  "bugs": "https://github.com/marinsokol5/trip-atlas/issues",
  "keywords": [
    "travel",
    "itinerary",
    "trip-planner",
    "map",
    "calendar",
    "cli",
    "agent-skill"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && vite build --config vite.node.config.ts",
    "lint": "oxlint",
    "schema": "node scripts/schema-types.mjs",
    "start": "npm run build && node scripts/serve.mjs",
    "serve": "node scripts/serve.mjs",
    "test": "node --test src/*.test.ts scripts/*.test.mjs",
    "pretest": "npm run build",
    "check": "npm run lint && npm test",
    "prepublishOnly": "npm run check",
    "build:pages": "tsc -b && vite build --mode pages && node scripts/pages.mjs",
    "release": "node scripts/release.mjs",
    "update": "npm install -g trip-atlas@latest && npx -y skills update -g trip-atlas-update-itinerary trip-atlas-download-booking"
  },
  "devDependencies": {
    "@cfworker/json-schema": "^4.1.1",
    "@types/d3-geo": "^3.1.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "d3-geo": "^3.1.1",
    "json-schema-to-typescript": "^16.0.0",
    "lucide-react": "^1.43.0",
    "oxlint": "^1.79.0",
    "prettier": "^3.9.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "rollup-plugin-license": "^3.7.1",
    "typescript": "~6.0.2",
    "vite": "^8.2.2"
  }
}
